DATABASE_URL="postgresql://user:password@localhost:5432/legacyhillestimator?schema=public"

# Session cookie signing key. Generate your own with: openssl rand -base64 32
SESSION_SECRET=""

# Seed login (see prisma/seed.ts) - change after first login
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Anthropic API key - used for scope drafting from transcripts and AI cost estimation fallback
ANTHROPIC_API_KEY=""

# Transcription provider API key (e.g. OpenAI Whisper)
TRANSCRIPTION_API_KEY=""

# Vercel Blob token - used for audio file uploads (set when deploying to Vercel)
BLOB_READ_WRITE_TOKEN=""
